# Hostcraft panel ----------------------------------------------------------
# Pinned image tag from ghcr.io/e-scheer/hostcraft. Use 'latest' to track the
# most recent release, or pin to vX.Y.Z for reproducibility.
HOSTCRAFT_IMAGE_TAG=latest

# REQUIRED in production. Generate with:
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=please-generate-a-real-secret-key

# Optional
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,hostcraft
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_LOG_LEVEL=INFO
HOSTCRAFT_HTTP_PORT=8080

# Dev only: host-facing port for the backend (Django). Internals always use
# 8000; bumping this avoids clashes with other Django/Rails projects on the host.
HOSTCRAFT_BACKEND_HOST_PORT=8001

# Initial admin (only used on first boot)
HOSTCRAFT_INITIAL_ADMIN_USER=admin
HOSTCRAFT_INITIAL_ADMIN_PASSWORD=please-change-me

# Minecraft container ------------------------------------------------------
MC_CONTAINER_NAME=hostcraft-minecraft
MC_VERSION=LATEST
MC_TYPE=PAPER
MC_MEMORY=4G
MC_EULA=TRUE
MC_RCON_PASSWORD=please-change-me-too
MC_RCON_PORT=25575
MC_SERVER_PORT=25565
